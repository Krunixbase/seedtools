{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://seedtools.dev/schemas/module-spec.schema.json",
    "title": "SeedTools Suite Module Specification",
    "description": "Schema defining Launcher-compatible modules.",
    "type": "object",
    "required": [
        "module_id",
        "name",
        "version",
        "category",
        "status",
        "location",
        "documentation",
        "launch_methods"
    ],
    "properties": {
        "module_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Unique immutable module identifier."
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "description": "Human readable module name."
        },
        "version": {
            "type": "string",
            "description": "Module version."
        },
        "category": {
            "type": "string",
            "enum": [
                "Recovery",
                "Forensics",
                "Entropy",
                "Analysis",
                "Interface",
                "Launcher",
                "Documentation"
            ]
        },
        "status": {
            "type": "string",
            "enum": [
                "available",
                "experimental",
                "planned",
                "deprecated"
            ]
        },
        "location": {
            "type": "string",
            "description": "Module directory location."
        },
        "description": {
            "type": "string"
        },
        "documentation": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string"
            }
        },
        "launch_methods": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "enum": [
                    "desktop",
                    "cli",
                    "workflow"
                ]
            }
        },
        "entrypoints": {
            "type": "object",
            "properties": {
                "desktop": {
                    "type": "string"
                },
                "cli": {
                    "type": "string"
                },
                "workflow": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "workflows": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "dependencies": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "tags": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "repository": {
            "type": "string"
        },
        "homepage": {
            "type": "string"
        }
    },
    "additionalProperties": false
}
